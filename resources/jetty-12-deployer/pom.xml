<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
    http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.codehaus.cargo</groupId>
    <artifactId>cargo-resources</artifactId>
    <version>1.10.30-SNAPSHOT</version>
  </parent>
  <artifactId>cargo-jetty-12-deployer</artifactId>
  <packaging>war</packaging>
  <name>Cargo Remote Deployer for Jetty (version 12.x)</name>
  <description>Webapp used by Cargo to remotely deploy applications on a Jetty 12.x server</description>
  <properties>
    <jetty.version>12.1.0</jetty.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-deploy</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee8</groupId>
      <artifactId>jetty-ee8-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee8</groupId>
      <artifactId>jetty-ee8-webapp</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee9</groupId>
      <artifactId>jetty-ee9-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee9</groupId>
      <artifactId>jetty-ee9-webapp</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-webapp</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee11</groupId>
      <artifactId>jetty-ee11-servlet</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee11</groupId>
      <artifactId>jetty-ee11-webapp</artifactId>
      <version>${jetty.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!--
        When JDK < 17, make disposable compiler-only copies of Jetty.

        Jetty 12.1 requires Java 17, while Cargo is compiled for Java 11.
        The copied JARs therefore have their Java 17 class-file versions
        rewritten to Java 11.

        These JARs MUST NOT be used at runtime.
        -->
      <id>java17-</id>
      <activation>
        <jdk>(,17)</jdk>
      </activation>
      <properties>
        <jetty.real.dir>
          ${project.build.directory}/jetty-real
        </jetty.real.dir>
        <jetty.fake.dir>
          ${project.build.directory}/jetty-fake
        </jetty.fake.dir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-jetty-dependencies</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${jetty.real.dir}</outputDirectory>
                  <includeScope>provided</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>rewrite-jetty-class-file-versions</id>
                <phase>process-sources</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/build-tools/classes"/>
                    <javac
                      srcdir="${basedir}/src/build-tools/java"
                      destdir="${project.build.directory}/build-tools/classes"
                      source="11"
                      target="11"
                      encoding="UTF-8"
                      includeantruntime="false"/>

                    <mkdir dir="${jetty.fake.dir}"/>
                    <copy todir="${jetty.fake.dir}">
                      <fileset dir="${jetty.real.dir}">
                        <include name="*.jar"/>
                      </fileset>
                    </copy>
                    <java
                      classname="org.codehaus.cargo.build.RewriteClassVersions"
                      fork="true"
                      failonerror="true">
                      <arg value="${jetty.fake.dir}"/>
                      <classpath>
                        <pathelement
                          location="${project.build.directory}/build-tools/classes"/>
                      </classpath>
                    </java>
                  </target>
                </configuration>
              </execution>

              <!--
                Compile the application using the fake Jetty JARs.

                Maven's compiler plugin cannot be used here because its normal
                dependency classpath contains the real Jetty JARs. Those JARs
                are Java 17 bytecode and therefore cannot be read by javac 11.

                The fake Jetty directory is placed first on the compiler
                classpath, followed by Maven's normal project dependencies.
                -->
              <execution>
                <id>compile</id>
                <phase>compile</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <property
                      name="compile_classpath"
                      refid="maven.compile.classpath"/>
                    <mkdir dir="${project.build.outputDirectory}"/>
                    <javac
                      srcdir="${basedir}/src/main/java"
                      destdir="${project.build.outputDirectory}"
                      source="11"
                      target="11"
                      encoding="UTF-8"
                      debug="true"
                      includeantruntime="false">
                      <classpath>
                        <fileset dir="${jetty.fake.dir}">
                          <include name="*.jar"/>
                        </fileset>
                        <pathelement path="${compile_classpath}"/>
                      </classpath>
                    </javac>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!--
            Maven Compiler and Javadoc plugins is disabled because compilation is performed
            by the Antrun javac task above with the fake Jetty classpath and fake JDK 11 JARs.
            -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <skipMain>true</skipMain>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <skippedModules>
                org.codehaus.cargo:cargo-jetty-12-deployer
              </skippedModules>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
